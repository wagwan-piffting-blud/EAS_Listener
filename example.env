# Web server: bind port for API.
MONITORING_BIND_PORT=8080

# Web server: bind port for dashboard.

# Web server: bind address (usually should not be modified).
MONITORING_BIND_ADDR=0.0.0.0:${MONITORING_BIND_PORT}

# The 24/7 alert stream's port, which the listener serves itself. Only used when you
# publish it in the compose file. Keep this the SAME as ICECAST_ALERT_PORT in
# config.json so the published port matches the port the stream is served on.
ICECAST_ALERT_PORT=8000

# Timezone for logging and other time-related operations.
TZ=America/Chicago

# TTS engine for CAP alert speech synthesis.
# Supported: "piper" (default, lightweight neural TTS), "espeak-ng", "speechify" (Tom),
# "cepstral" (Cepstral Swift 6.2, the DASDEC voices), "loquendo" (Loquendo 6.9 Dave).
TTS_ENGINE=piper

# Voice selector. Piper: a path to an .onnx model, defaulting to
# /app/piper/en_US-lessac-medium.onnx in Docker. Cepstral: a voice name -- Allison (default),
# David, Jean-Pierre or William. Ignored by espeak-ng, speechify and loquendo, which each ship
# exactly one voice.
# TTS_MODEL=/app/piper/en_US-lessac-medium.onnx

# Where the Cepstral voices are installed. They are 80-211 MB each and are downloaded on the
# first boot that selects the cepstral engine, so this wants to be on the state volume.
# CEP6_VOICE_DIR=/data/tts_voices/cep6

# Dave is built into loqdave, so this is empty by default. Set it only to run loqdave against a
# different Loquendo voice tree, which then replaces the built-in one.
# LOQ6_DATA_DIR=/srv/loquendo/data
# Where the Tom voice is. Docker fetches it with spfy_synth on the first boot that selects the
# speechify engine and points this at it; a portable install gets it from
# tools/fetch_components.sh, in tts_voices/spfy/voices/tom beside the binary.
# SPFY_VOICE_DIR=/data/tts_voices/spfy/voices/tom
# With TTS_ENGINE=speechify, TTS_MODEL picks the voice: a bare name looked for inside
# SPFY_VOICE_DIR and then beside it, or a path.
# TTS_MODEL=crstom
