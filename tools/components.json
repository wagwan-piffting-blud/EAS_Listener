{
    "schema": 2,
    "note": "Pinned third-party binaries the listener shells out to. Every one runs as a separate process and none is linked in, so each keeps its own licence. A component with system_packages falls back to the distro's package on a Linux platform with no pinned build. Fetching these puts the user in a direct relationship with each upstream, so this project never redistributes them. If you switch to bundling instead, the obligations in tools/README.md apply.",
    "templates": "A component with github and release_tag downloads each platform's asset from https://github.com/{github}/releases/download/{tag}/{asset}. In any string of a component, {tag} is its release_tag, {version} its version (the release_tag when absent) and {github} its repository. Bump a pin with tools/update_components.py rather than by hand: it rewrites release_tag, version and every sha256 from GitHub's own asset digests.",
    "components": {
        "ffmpeg": {
            "provides": ["ffmpeg"],
            "requirement": "required",
            "license": "LGPL-3.0-or-later",
            "license_note": "FFmpeg is LGPL-2.1-or-later at its core; this build adds --enable-version3, making it LGPL-3.0-or-later, which is compatible with this project's GPL-3.0. The LGPL build is deliberate and sufficient: the only encoders this project asks for are libmp3lame (LGPL-2.0-or-later) and libopus (BSD-3-Clause), per RecordingFormat::ffmpeg_codec_args in src/config.rs. Verified in the pinned build: --enable-libmp3lame and --enable-libopus are present; --enable-gpl and --enable-nonfree are absent and x264/x265/xvid/fdk-aac are explicitly disabled. Never substitute an --enable-nonfree build; those are not redistributable at all.",
            "project_url": "https://ffmpeg.org/",
            "builder_url": "https://github.com/BtbN/FFmpeg-Builds",
            "source_url": "https://github.com/BtbN/FFmpeg-Builds/blob/master/README.md",
            "github": "BtbN/FFmpeg-Builds",
            "track": "^autobuild-",
            "retained": "month-end",
            "version": "n8.1.3-9-g29e619e767",
            "release_tag": "autobuild-2026-09-30-13-08",
            "install": "archive",
            "system_packages": {
                "apt-get": "ffmpeg",
                "dnf": "ffmpeg-free",
                "apk": "ffmpeg",
                "pacman": "ffmpeg",
                "zypper": "ffmpeg",
                "brew": "ffmpeg"
            },
            "platforms": {
                "windows-x86_64": {
                    "asset": "ffmpeg-{version}-win64-lgpl-8.1.zip",
                    "sha256": "4a7642b2264c03e8a0ce8a3825b933ee5580656f45695a086fe7e294045ffc0a",
